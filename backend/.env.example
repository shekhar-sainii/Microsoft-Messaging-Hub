# ========================
# Microsoft Messaging Hub
# Backend Environment Variables
# ========================

# --- Server ---
PORT=3000
# Set to 'production' for live deployment
NODE_ENV=development

# --- Database ---
# MongoDB connection string. For Docker, use 'mongodb://mongodb:27017/messaging-hub'
MONGODB_URI=mongodb://localhost:27017/microsoft-messaging-hub

# --- Redis ---
# Redis URL connection string (recommended for free cloud services like Upstash/Render)
REDIS_URL=redis://default:password@hostname.upstash.io:6379
# Fallback individual keys for local/Docker setup
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Azure AD App Registration ---
# Your Azure AD Tenant ID (found in Azure Portal > App Registrations > Your App > Overview)
TENANT_ID=your_tenant_id_here
# Your Azure AD App Client ID (Application ID from App Registration overview)
CLIENT_ID=your_client_id_here
# Client Secret generated in Azure Portal > App Registrations > Certificates & Secrets
# NEVER commit the actual value. Store only in .env (which is gitignored)
CLIENT_SECRET=your_client_secret_here

# --- Webhook Configuration ---
# The public URL of your webhook endpoint, exposed via ngrok in development.
# Example: https://abc123.ngrok-free.app/webhook/graph
WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/webhook/graph
# A random secret string used to verify webhook notifications via HMAC.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_CLIENT_STATE=your_random_secret_hmac_string

# --- RSA Keys for Encrypted Notifications ---
# Paths to RSA key files. Generate with:
#   openssl genrsa -out certs/private.pem 2048
#   openssl rsa -in certs/private.pem -pubout -out certs/public.pem
RSA_PRIVATE_KEY_PATH=./certs/private.pem
RSA_PUBLIC_KEY_PATH=./certs/public.pem

# --- JWT Session Secret ---
# Secret used to sign backend session JWTs. Must be a long, random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_long_random_jwt_secret_here

# --- Outgoing Webhook (Bonus) ---
# The HMAC token provided by Teams when registering an Outgoing Webhook.
# Found in Teams > Apps > Outgoing Webhook > Security Token
TEAMS_OUTGOING_WEBHOOK_TOKEN=your_outgoing_webhook_token_here

# --- Admin Portal Configuration ---
# Comma-separated list of authorized superuser/administrator email addresses
ADMIN_EMAILS=admin@yourtenant.onmicrosoft.com,manager@company.com
